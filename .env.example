# Copy this file to `.env` and replace the placeholder with your real connection string.
# Set FRONTEND_ORIGIN to the frontend origin (for example, http://localhost:5173).
FRONTEND_ORIGIN=
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Use at least 32 random bytes encoded as hexadecimal.
PASSWORD_PEPPER=
# Use a random secret of at least 32 characters.
JWT_ACCESS_SECRET=
